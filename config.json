{
	"name": "Flight Connector",
	"namespace": "Vanderbilt\\FlightConnectorExternalModule",
	"description": "A REDCap External Module that transforms a list of concepts/contents and tools/methods into a REDCap survey, whose data is turned into a social network map of topics.",
	"authors": [
		{
			"name": "Scott J. Pearson",
			"email": "scott.j.pearson@vumc.org",
			"institution": "Vanderbilt University Medical Center"
		}
	],
	"permissions": [
		"redcap_every_page_before_render",
		"redcap_every_page_top",
		"redcap_survey_page"
	],
	"links": {
		"project": [
			{
				"name": "Flight Connector Map",
				"icon": "fa-regular fa-map",
				"url": "map.php?NOAUTH"
			},
			{
				"name": "Flight Connector ReadMe",
				"icon": "fa-solid fa-book",
				"url": "README.md"
			}
		]
	},
	"framework-version": 9,
	"compatibility": {
		"php-version-min": "7.3.0",
		"php-version-max": "",
		"redcap-version-min": "11.1.1",
		"redcap-version-max": ""
	},
	"no-auth-pages": [
		"map",
		"lookupMatches",
		"generateQR"
	],
	"project-settings": [
	],

	"crons": [
		{
			"cron_name": "flight_connector_cron",
			"cron_description": "Flight Connector Cron",
			"method": "cron",
			"cron_weekday": "1",
			"cron_hour": "05",
			"cron_minute": "00"
		}
	]
}
